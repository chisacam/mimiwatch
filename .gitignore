# 전사 결과와 내려받은 오디오, 그리고 작업·라이브 상태 DB(mimiwatch.db*).
# 저작물이거나 이 컴퓨터에서만 뜻이 있는 것들입니다.
data/

# 실제 엔드포인트 설정. API 키가 평문으로 들어갑니다.
# backends.example.json 을 복사해서 쓰십시오.
backends.json

# 실측 원자료. 결론은 measurements/RESULTS.md 에 정리되어 있습니다.
# 방송 발화 내용이 그대로 들어 있으므로 저장소에 두지 않습니다.
measurements/*.json
measurements/*.log
measurements/*.err
measurements/*.txt

__pycache__/
*.pyc
.DS_Store

# 서브에이전트 작업용 워크트리
.claude/
