# 전사 결과와 내려받은 오디오, 그리고 작업·라이브 상태 DB(mimiwatch.db*).
# 저작물이거나 이 컴퓨터에서만 뜻이 있는 것들입니다.
data/

# 실제 엔드포인트 설정. API 키가 평문으로 들어갑니다.
# backends.example.json 을 복사해서 쓰십시오.
backends.json

# 실측 원자료. 결론은 measurements/RESULTS.md 에 정리되어 있습니다.
# 방송 발화 내용이 그대로 들어 있으므로 저장소에 두지 않습니다.
measurements/*.json
measurements/*.log
measurements/*.err
measurements/*.txt

__pycache__/
*.pyc
.DS_Store

# 서브에이전트 작업용 워크트리와, 저장소에 둘 필요 없는 로컬 메모(리뷰·판단 대기).
# skills/ 만 예외입니다 -- 이 저장소에서만 뜻이 있는 절차이므로 공유 스킬 저장소가 아니라
# 여기에 두고, 저장소를 받은 기계에서 바로 걸리도록 함께 따라다녀야 합니다.
.claude/*
!.claude/skills/

# 자체 가상환경 (.venv-build 는 packaging/build.sh 가 만듭니다)
.venv/
.venv-build/

# 번역 모델 비교 표본과 원자료. 방송 발화가 그대로 들어 있습니다.
bench/*.json

# PyInstaller 산출물 (packaging/build.sh · build.ps1)
build/
dist/
*.spec.bak
